```env
# ======================================================
# OmniMind AI - Environment Variables Template
# ======================================================
# Copy this file to ".env" and replace the placeholder
# values with your actual API keys.
# Never commit your real ".env" file to GitHub.
# ======================================================

# ==============================
# OpenAI
# ==============================
OPENAI_API_KEY=your_openai_api_key_here

# ==============================
# Google Gemini
# ==============================
GOOGLE_API_KEY=your_google_api_key_here

# ==============================
# Groq (Optional)
# ==============================
GROQ_API_KEY=your_groq_api_key_here

# ==============================
# Web Search (Optional)
# ==============================
SERPER_API_KEY=your_serper_api_key_here

# ==============================
# Hugging Face (Optional)
# ==============================
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# ==============================
# ElevenLabs (Optional)
# ==============================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ==============================
# Tavily Search (Optional)
# ==============================
TAVILY_API_KEY=your_tavily_api_key_here

# ==============================
# Application Settings
# ==============================
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# ==============================
# Database
# ==============================
DATABASE_URL=sqlite:///database/assistant.db

# ==============================
# Vector Database
# ==============================
VECTOR_DB_PATH=database/vector_store

# ==============================
# Upload Directory
# ==============================
UPLOAD_DIR=uploads

# ==============================
# Export Directory
# ==============================
EXPORT_DIR=exports

# ==============================
# Default AI Model
# ==============================
DEFAULT_MODEL=gpt-5.5

# ==============================
# Streamlit
# ==============================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
```
